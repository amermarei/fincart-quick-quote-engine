# Fixed FX rates. Do not fetch live rates.
# Format: comma-separated CURRENCY:rate-to-USD pairs.
# Only CAD is currently required; the others are here because the config format
# has to survive a carrier that prices in something else.
FX_RATES=CAD:0.73,GBP:1.27,EUR:1.09

# Presentation currency for all merchant-facing amounts.
PRESENTATION_CURRENCY=USD

# Seeds the mock carrier transports. Set this to a fixed value for
# reproducible benchmarks and tests. Leave unset for time-based randomness.
#
# NOTE: this is read at module load time, inside the provider modules. Load
# your env config BEFORE importing anything under starter/providers/, or the
# seed is silently ignored.
PROVIDER_SEED=

# Per-carrier deadline, milliseconds. Tune as you see fit.
CARRIER_TIMEOUT_MS=

# Overall request deadline, milliseconds. Tune as you see fit.
REQUEST_DEADLINE_MS=

JWT_SECRET=change-me
DATABASE_URL=
PORT=4000
