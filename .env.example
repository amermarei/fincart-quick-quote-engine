# Fixed FX rates. Do not fetch live rates.
# Format: comma-separated CURRENCY:rate-to-USD pairs.
FX_RATES=CAD:0.73,GBP:1.27,EUR:1.09

# Presentation currency for all merchant-facing amounts.
PRESENTATION_CURRENCY=USD

# Seeds the mock carrier transports. Fixed value = reproducible benchmarks/tests.
# Read at module load inside the provider modules; load env BEFORE importing them.
PROVIDER_SEED=42

# Per-carrier deadline, milliseconds.
CARRIER_TIMEOUT_MS=3000

# Overall request deadline, milliseconds.
REQUEST_DEADLINE_MS=3400

JWT_SECRET=change-me

# PostgreSQL (Aiven). Replace USERNAME/PASSWORD with the real credentials.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:25051/defaultdb?sslmode=require

# Dedicated TEST database on the same instance — npm test resets ONLY this
# database (the test bootstrap refuses to run if it does not point at a
# database literally named qqe_test).
TEST_DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:25051/qqe_test?sslmode=require

PORT=4000